NOVOYA_ENV=development
NOVOYA_DATABASE_URL=postgresql+asyncpg://novoya:novoya@localhost:5432/novoya
NOVOYA_CORS_ORIGINS=["http://localhost:5173"]

# Accounts (sign-in, sessions, roles). The defaults suit local development.
NOVOYA_FRONTEND_URL=http://localhost:5173
NOVOYA_SESSION_COOKIE_SECURE=false
NOVOYA_SMTP_HOST=localhost
NOVOYA_SMTP_PORT=1025
# NOVOYA_SESSION_IDLE_TTL_DAYS=7
# NOVOYA_SESSION_ABSOLUTE_TTL_DAYS=30
# NOVOYA_REQUIRE_VERIFIED_EMAIL=true
# NOVOYA_MAIL_FROM="Novoya <no-reply@novoya.local>"
# NOVOYA_ARGON2_TIME_COST=3
# NOVOYA_ARGON2_MEMORY_COST_KIB=65536

# Added by later issues, listed here so everyone knows what is coming:
# NOVOYA_GOOGLE_CLIENT_ID=            (#15)
# NOVOYA_GOOGLE_CLIENT_SECRET=        (#15)
# NOVOYA_OPENROUTER_API_KEY=          (#22)
