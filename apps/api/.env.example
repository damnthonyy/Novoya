NOVOYA_ENV=development
NOVOYA_DATABASE_URL=postgresql+asyncpg://novoya:novoya@localhost:5432/novoya
NOVOYA_CORS_ORIGINS=["http://localhost:5173"]

# Accounts (sign-in, sessions, roles). The defaults suit local development.
NOVOYA_FRONTEND_URL=http://localhost:5173
NOVOYA_SESSION_COOKIE_SECURE=false
NOVOYA_SMTP_HOST=localhost
NOVOYA_SMTP_PORT=1025
# A real email provider also needs (Mailpit does not):
# NOVOYA_SMTP_USERNAME=
# NOVOYA_SMTP_PASSWORD=
# NOVOYA_SMTP_START_TLS=true
# NOVOYA_SESSION_IDLE_TTL_DAYS=7
# NOVOYA_SESSION_ABSOLUTE_TTL_DAYS=30
# NOVOYA_REQUIRE_VERIFIED_EMAIL=true
# NOVOYA_MAIL_FROM="Novoya <no-reply@novoya.local>"
# NOVOYA_ARGON2_TIME_COST=3
# NOVOYA_ARGON2_MEMORY_COST_KIB=65536

# LLM through OpenRouter (#22). Get a key at https://openrouter.ai/keys.
# The models must support tool calling. The fallbacks are tried in order when a model fails;
# NOVOYA_LLM_FALLBACK_MODELS is a JSON list ([] for none).
# Free models are blocked by OpenRouter's Zero Data Retention setting: allow them at
# https://openrouter.ai/settings/privacy, but keep "free endpoints that publish prompts" off.
NOVOYA_OPENROUTER_API_KEY=
NOVOYA_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
NOVOYA_LLM_FALLBACK_MODELS=["nvidia/nemotron-3-super-120b-a12b:free","xingchen-agi/xing4.0-29b-a4b:free","google/gemma-4-31b-it:free"]

# Sign-in with Google (#15). The client comes from the Google Cloud project (#14); ask the
# team for its ID and secret, never commit them. Without both, Google sign-in is off.
# The redirect URI registered at Google is NOVOYA_API_PUBLIC_URL + /auth/google/callback.
NOVOYA_API_PUBLIC_URL=http://localhost:8000
NOVOYA_GOOGLE_CLIENT_ID=
NOVOYA_GOOGLE_CLIENT_SECRET=
