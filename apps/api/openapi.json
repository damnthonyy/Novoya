{
  "components": {
    "schemas": {
      "DestinationOut": {
        "properties": {
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "country": {
            "title": "Country",
            "type": "string"
          }
        },
        "required": [
          "country",
          "city"
        ],
        "title": "DestinationOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "PanelOut": {
        "description": "The preference panel (ARCHITECTURE.md section 3). Render it with generic components.",
        "properties": {
          "ask_budget": {
            "title": "Ask Budget",
            "type": "boolean"
          },
          "ask_dates": {
            "title": "Ask Dates",
            "type": "boolean"
          },
          "ask_persons": {
            "title": "Ask Persons",
            "type": "boolean"
          },
          "sections": {
            "items": {
              "$ref": "#/components/schemas/PanelSectionOut"
            },
            "title": "Sections",
            "type": "array"
          }
        },
        "required": [
          "sections",
          "ask_budget",
          "ask_persons",
          "ask_dates"
        ],
        "title": "PanelOut",
        "type": "object"
      },
      "PanelSectionOut": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "multi": {
            "title": "Multi",
            "type": "boolean"
          },
          "tags": {
            "items": {
              "$ref": "#/components/schemas/TagOut"
            },
            "title": "Tags",
            "type": "array"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "multi",
          "tags"
        ],
        "title": "PanelSectionOut",
        "type": "object"
      },
      "SendWishRequest": {
        "properties": {
          "text": {
            "maxLength": 1000,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]*$",
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "SendWishRequest",
        "type": "object"
      },
      "TagOut": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "preselected": {
            "title": "Preselected",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "label",
          "preselected"
        ],
        "title": "TagOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WishResponse": {
        "description": "panel_shown: show the panel. not_covered: we don't go there, offer the suggestions.\ndraft: the text names no place, ask where, with the suggestions as choices.",
        "properties": {
          "destination": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DestinationOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "panel": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PanelOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "draft",
              "not_covered",
              "panel_shown"
            ],
            "title": "Status",
            "type": "string"
          },
          "suggestions": {
            "items": {
              "$ref": "#/components/schemas/DestinationOut"
            },
            "title": "Suggestions",
            "type": "array"
          }
        },
        "required": [
          "id",
          "status",
          "destination",
          "panel",
          "suggestions"
        ],
        "title": "WishResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Novoya API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Liveness: the process is up.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/health/db": {
      "get": {
        "description": "Readiness: the database answers.",
        "operationId": "getDbHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Db Health",
        "tags": [
          "health"
        ]
      }
    },
    "/wishes": {
      "post": {
        "description": "Send the trip the client wants, in their words. Returns the panel when we cover the\ndestination, suggestions when we don't, and asks where when the text names no place.",
        "operationId": "sendWish",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendWishRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WishResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Send Wish",
        "tags": [
          "wishes"
        ]
      }
    }
  }
}
